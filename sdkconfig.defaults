###

# custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# enable coredump
CONFIG_ESP_COREDUMP_ENABLE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# enable web sockets
CONFIG_HTTPD_WS_SUPPORT=y

# to change log levels at runtime
CONFIG_LOG_DYNAMIC_LEVEL_CONTROL=y

# enable longer names on sdcard
CONFIG_FATFS_LFN_HEAP=y

# enable console output on the serial
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_CUSTOM is not set
# CONFIG_ESP_CONSOLE_NONE is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y
CONFIG_ESP_CONSOLE_UART_NUM=-1
CONFIG_ESP_CONSOLE_ROM_SERIAL_PORT_NUM=3

CONFIG_MM_EVENT_TASK_ADDITIONAL_STACK=2560

# default MM log levels

CONFIG_MM_LOG_LEVEL=4
CONFIG_MM_CLI_LOG_LEVEL=4
CONFIG_MM_IO_LOG_LEVEL=4
CONFIG_MM_NET_LOG_LEVEL=4
CONFIG_MM_PORT_LOG_LEVEL=4
CONFIG_MM_UI_LOG_LEVEL=4
CONFIG_MM_UTILS_LOG_LEVEL=4

#CONFIG_TINYUSB_HID_COUNT=1
