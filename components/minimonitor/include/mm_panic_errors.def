//             Error, Description
// ----------------------------------------------------------------------------
FOR_EACH_ERROR(UNKWN, Reset reason can not be determined)
FOR_EACH_ERROR(WD001, Reset (software or hardware) due to interrupt watchdog)
FOR_EACH_ERROR(WD002, Reset due to task watchdog)
FOR_EACH_ERROR(WD003, Reset due to other watchdogs)
FOR_EACH_ERROR(EFUSE, Reset due to efuse error)
FOR_EACH_ERROR(PWRGL, Reset due to power glitch detected)
FOR_EACH_ERROR(DBEXP, Reset due to CPU lock up (double exception))
FOR_EACH_ERROR(DBEXP, Reset due to CPU lock up (double exception))
