FOR_EACH_ERROR(XT005, AllocaCause)
FOR_EACH_ERROR(XT006, IntegerDivideByZeroCause)
FOR_EACH_ERROR(XT008, PrivilegedCause)
FOR_EACH_ERROR(XT009, LoadStoreAlignmentCause)
FOR_EACH_ERROR(XT012, InstrPIFDateErrorCause)
FOR_EACH_ERROR(XT013, LoadStorePIFDataErrorCause)
FOR_EACH_ERROR(XT014, InstrPIFAddrErrorCause)
FOR_EACH_ERROR(XT015, LoadStorePIFAddrErrorCause)
FOR_EACH_ERROR(XT016, InstTLBMissCause)
FOR_EACH_ERROR(XT017, InstTLBMultiHitCause)
FOR_EACH_ERROR(XT018, InstFetchPrivilegeCause)
FOR_EACH_ERROR(XT020, InstFetchProhibitedCause)
FOR_EACH_ERROR(XT024, LoadStoreTLBMissCause)
FOR_EACH_ERROR(XT025, LoadStoreTLBMultiHitCause)
FOR_EACH_ERROR(XT026, LoadStorePrivilegeCause)
FOR_EACH_ERROR(XT028, LoadProhibitedCause)
FOR_EACH_ERROR(XT029, StoreProhibitedCause)
FOR_EACH_ERROR(XT032, Coprocessor0Disabled)
FOR_EACH_ERROR(XT033, Coprocessor1Disabled)
FOR_EACH_ERROR(XT034, Coprocessor2Disabled)
FOR_EACH_ERROR(XT035, Coprocessor3Disabled)
FOR_EACH_ERROR(XT036, Coprocessor4Disabled)
