FOR_EACH_ERROR(RV000, Instruction address misaligned)
FOR_EACH_ERROR(RV001, Instruction access fault)
FOR_EACH_ERROR(RV002, Illegal instruction)
FOR_EACH_ERROR(RV003, Breakpoint)
FOR_EACH_ERROR(RV004, Load address misaligned)
FOR_EACH_ERROR(RV005, Load access fault)
FOR_EACH_ERROR(RV006, Store/AMO address misaligned)
FOR_EACH_ERROR(RV007, Store/AMO access fault)
FOR_EACH_ERROR(RV008, Environment call from U-mode)
FOR_EACH_ERROR(RV009, Environment call from S-mode)
FOR_EACH_ERROR(RV011, Environment call from M-mode)
FOR_EACH_ERROR(RV012, Instruction page fault)
FOR_EACH_ERROR(RV013, Load page fault)
FOR_EACH_ERROR(RV015, Store/AMO page fault)
FOR_EACH_ERROR(RV016, Double trap)
FOR_EACH_ERROR(RV018, Software check)
FOR_EACH_ERROR(RV019, Hardware error)
